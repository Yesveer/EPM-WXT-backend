MONGO_URI=mongodb+srv://kaal:kaal123@machine.7vzoy0a.mongodb.net/?appName=machine
MONGO_DB_NAME=vsay-epm
CLOUDINARY_URL=cloudinary://783394936861218:CFyxF9HGVNws8YujLFlfEpsJdGQ@dblrqxs6d
RECONCILER_INTERVAL=1m
OFFLINE_TIMEOUT=2m
GIN_MODE=release

# Authentication is handled by vsay-auth gateway - no JWT secret needed in backend
# Gateway Secret for authenticating requests from vsay-auth (must match vsay-auth GATEWAY_SECRET)
GATEWAY_SECRET=vsay-gateway-super-secret-token-change-in-production-2026

# TLS Configuration
# TLS_ENABLED=false → HTTP on 8080 | true → HTTPS on 8443
TLS_ENABLED=false
# gRPC always uses mTLS (Private CA) — GRPC_MTLS_ENABLED is ignored
TLS_CERT_FILE=./certs/server-cert.pem
TLS_KEY_FILE=./certs/server-key.pem

# Private CA — signs agent client certs for mTLS
CA_CERT_FILE=./certs/ca-cert.pem
CA_KEY_FILE=./certs/ca-key.pem

# Domain for gRPC TLS cert SAN (used if auto-generating self-signed cert)
SERVER_DOMAIN=192.168.1.8

# Agent self-update
# Public base URL agents use to download packages (the vsay-auth gateway).
# Must be reachable FROM the agent machines.
BACKEND_PUBLIC_URL=http://192.168.1.8:8082
# The version the portal treats as "latest" — bump this each time you run
# `make deploy-binaries` with a new build. Agents reporting a different version
# will be offered the update.
LATEST_AGENT_VERSION=1.2.1-rc3
# Directory the 8 agent packages are served from (defaults to ./agent-binaries)
# AGENT_BINARIES_DIR=./agent-binaries

# Remote desktop (RDP/VNC via guacd)
# Where the backend reaches guacd (guacd container publishes 4822 on the host).
GUACD_ADDR=127.0.0.1:4822
# How the guacd CONTAINER reaches back to this backend's per-session tunnel bridge.
# Must be an address the container can reach — the host's LAN IP is the most reliable
# (host.docker.internal can be flaky on Docker Desktop). Set to this machine's IP.
GUACD_HOST_GATEWAY=192.168.1.8


